# Base URL of the website (laratranslate.com)
BASE_URL=https://laratranslate.com

# App URL for authenticated pages (app.laratranslate.com)
APP_URL=https://app.laratranslate.com

# Authentication credentials for test user
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=changeme

# UI language for the app (set via header language selector)
UI_LANGUAGE=English

# Environment: local | staging | production
ENV=local
