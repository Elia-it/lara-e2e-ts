# Base URL of the website (laratranslate.com)
BASE_URL=https://laratranslate.com

# App URL for authenticated pages (app.laratranslate.com)
APP_URL=https://app.laratranslate.com

# Authentication credentials for test user
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=changeme

# Environment: local | staging | production
ENV=local

# S3 Report Storage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-west-1
S3_BUCKET_NAME=your-bucket-name
CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net
